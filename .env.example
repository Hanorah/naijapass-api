PORT=4000
NODE_ENV=development

CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# XAMPP MySQL (Windows)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=naijapass

# Redis in WSL Ubuntu on this PC (cache only — not a remote deploy)
# redis-cli ping → PONG
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=dev-naijapass-change-me-before-production
JWT_EXPIRES_IN=7d

# Seeded admin is always admin@naijapass.ng / AdminPass123!
GOOGLE_AI_API_KEY=
