PORT=4000
NODE_ENV=development
TRUST_PROXY=0

CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# XAMPP MySQL (Windows)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=naijapass

REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=dev-naijapass-change-me-before-production
JWT_EXPIRES_IN=7d

# Frontend origin (password-reset links)
APP_PUBLIC_URL=http://localhost:3000

# Seeded accounts after `npm run db:seed`:
#   admin@naijapass.ng / AdminPass123!
#   lagos@govt.naijapass.ng / GovtPass123!
#   fct@govt.naijapass.ng / GovtPass123!
#
# Re-import former Supabase content (profiles/projects/tenders/state_content/field_reports):
#   npm run db:import-supabase
# CSVs live in data/supabase-export/ (or set CSV_DIR=...).
# After import, all *@govt.naijapass.ng use GovtPass123!; other imported users use NaijaPass123!.

# Gemini (CivicChat) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=NaijaPass <onboarding@resend.dev>

KYC_API_KEY=
KYC_PROVIDER_URL=
